# ---------------------------------------------------------------------------
# MOBILIER-SHOP — frontend (Vite + React)
# Copier ce fichier en `.env` puis adapter les valeurs.
# NE JAMAIS committer `.env`.
#
# Aucun secret n'est exposé ici : seules des variables VITE_* (publiques)
# sont autorisées. Les tokens d'authentification vivent en mémoire et dans
# un cookie httpOnly posé par le backend.
# ---------------------------------------------------------------------------

# URL de base de l'API.
# - en développement via `npm run dev` : "/api" (proxy Vite vers :3000)
# - en production Docker : "/api" (proxy nginx vers le service `backend`)
VITE_API_URL=/api

# Cible du proxy Vite en développement (ignoré en production).
VITE_PROXY_TARGET=http://localhost:3000
